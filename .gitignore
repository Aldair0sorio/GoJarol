
# ==========================================
# Go Jarol - Git Ignore
# ==========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
*.egg
pip-wheel-metadata/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# IDEs and editors
.idea/
.vscode/
*.iml
*.swp
*.swo

# Python testing and analysis
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml


# Node.js / pnpm
node_modules/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# React / Vite
dist/
.vite/
*.tsbuildinfo

# Django
*.sqlite3
*.sqlite3-journal
staticfiles/
media/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Operating systems
.DS_Store
Thumbs.db
desktop.ini
